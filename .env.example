# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed as a schema reference.

# ---------------------------------------------------------------------------
# LLM (DeepSeek via OpenAI-compatible API)
# ---------------------------------------------------------------------------
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_CODEGEN_MODEL=deepseek-chat
LLM_REFLECTION_MODEL=deepseek-reasoner
LLM_CURRICULUM_MODEL=deepseek-chat
LLM_CODEGEN_TEMPERATURE=0.0
LLM_MAX_FIX_ATTEMPTS=3
LLM_REQUEST_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# Postgres (analytics DB) — host/port match docker-compose.yml
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=crafter_analytics
POSTGRES_USER=crafter
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# ChromaDB (skill library) — host/port match docker-compose.yml
# ---------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SKILLS_COLLECTION=skills

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
EMB_MODEL_NAME=all-MiniLM-L6-v2
EMB_TOP_K=5
EMB_SIMILARITY_REUSE_THRESHOLD=0.85    # above → reuse existing skill
EMB_SIMILARITY_DEDUP_THRESHOLD=0.70    # above → reject as duplicate on save

# ---------------------------------------------------------------------------
# Executor
# ---------------------------------------------------------------------------
EXEC_MAX_STEPS_PER_SKILL=200
EXEC_HEALTH_INTERRUPT_THRESHOLD=5
EXEC_STAGNATION_WINDOW=15

# ---------------------------------------------------------------------------
# Environment (Crafter)
# ---------------------------------------------------------------------------
ENV_VIEW_WIDTH=9
ENV_VIEW_HEIGHT=7
ENV_WORLD_SIZE=64

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
